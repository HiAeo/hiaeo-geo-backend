# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database (SQLite for development)
DB_TYPE=sqlite
DB_DATABASE=./database/hiaeo.db
DB_SYNC=true
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=hiaeo-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173,https://hiaeo-geo-frontend-ptz1y9zsp-hi-aeo.vercel.app

# AI Engines (配置你自己的API Key)
DEEPSEEK_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
DOUBAO_API_KEY=
ZHIPU_API_KEY=
ERNIE_API_KEY=

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ============================================
# 数据库配置 (支持 SQLite/MySQL/PostgreSQL)
# ============================================

# SQLite (开发 - 默认)
DB_TYPE=sqlite
DB_DATABASE=./database/hiaeo.db
DB_SYNC=true
DB_LOGGING=false

# MySQL (生产环境)
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=hiaeo123456
# DB_DATABASE=hiaeo
# DB_SYNC=true
# DB_LOGGING=false

# ============================================
# 支付配置 (生产环境)
# ============================================

# 启用模拟支付 (开发: true, 生产: false)
MOCK_PAYMENT=true

# API基础URL (用于支付回调)
API_BASE_URL=https://your-api-domain.com

# 前端URL
FRONTEND_URL=https://your-frontend-domain.com

# ---- 支付宝配置 ----
# ALIPAY_APP_ID=your_app_id
# ALIPAY_PRIVATE_KEY=your_private_key (RSA2格式)
# ALIPAY_PUBLIC_KEY=alipay_public_key
# ALIPAY_SANDBOX=false

# ---- 微信支付配置 (APIv3) ----
# WECHAT_MCH_ID=your_mch_id
# WECHAT_SERIAL_NO=your_serial_no
# WECHAT_PRIVATE_KEY=your_private_key
# WECHAT_APIV3_KEY=your_apiv3_key
# WECHAT_APP_ID=your_app_id
# WECHAT_SANDBOX=false

# ============================================
# 定时任务配置
# ============================================
ENABLE_RENEWAL_TASK=true
ENABLE_AUTO_RENEWAL=false
ENABLE_ORDER_CLEANUP=true
ENABLE_PAYMENT_REPORT=true

# ============================================
# 安全配置
# ============================================
PAYMENT_SECRET_KEY=your-payment-secret-key

# ============================================
# 邮件服务配置
# ============================================
# 邮件服务提供商: console(开发)/smtp/sendgrid/aliyun
MAIL_PROVIDER=console

# SMTP配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# 发送者配置
MAIL_FROM=Hiaeo <noreply@hiaeo.com>

# SendGrid配置 (替换SMTP)
/SENDGRID_API_KEY=your-sendgrid-api-key

# 阿里云邮件配置
# ALIYUN_ACCESS_KEY_ID=your-access-key-id
# ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
# ALIYUN_REGION=cn-hangzhou

# PostgreSQL (生产环境，取消注释并配置)
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=your_password
# DB_DATABASE=hiaeo
# DB_SCHEMA=public
# DB_SYNC=false
# DB_LOGGING=true

# ============================================
# Redis 配置 (用于缓存和会话)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# JWT 认证配置
# ============================================
JWT_SECRET=hiaeo-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ============================================
# CORS 配置
# ============================================
CORS_ORIGIN=http://localhost:5173,https://hiaeo-geo-frontend-ptz1y9zsp-hi-aeo.vercel.app

# ============================================
# AI 引擎配置 (配置你自己的 API Key)
# 
# DeepSeek API Key 获取地址: https://platform.deepseek.com/
# Kimi API Key 获取地址: https://platform.moonshot.cn/
# Qwen API Key 获取地址: https://dashscope.console.aliyun.com/
# 豆包 API Key 获取地址: https://console.volcengine.com/ark (推荐，有免费额度)
# ============================================
# DeepSeek API Key (当前 Key 已过期，需重新申请)
# DEEPSEEK_API_KEY=sk-your-new-key
KIMI_API_KEY=
QWEN_API_KEY=
# 豆包 API Key (推荐配置)
DOUBAO_API_KEY=ark-15f773c5-b7b2-4746-bb5a-e9a217301a1a-cf6d2
ZHIPU_API_KEY=
ERNIE_API_KEY=

# 默认 AI 引擎: deepseek / doubao / kimi / qwen / zhipu
DEFAULT_AI_ENGINE=doubao

# ==========================================
# 向量数据库配置
# ==========================================

# 向量数据库类型: milvus | pinecone | qdrant | memory (默认)
VECTOR_DB_PROVIDER=memory

# Milvus 配置
MILVUS_ADDRESS=localhost:19530
MILVUS_DB=knowledge_base
MILVUS_COLLECTION=brand_knowledge_embeddings
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_SSL=false
MILVUS_TIMEOUT=30000

# Pinecone 配置
PINECONE_API_KEY=
PINECONE_ENV=us-east-1
PINECONE_INDEX=brand-knowledge
PINECONE_PROJECT_ID=

# Qdrant 配置
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=brand_knowledge
QDRANT_API_KEY=

# 向量参数
VECTOR_DIMENSION=1536
VECTOR_METRIC=COSINE

# 连接池配置
VECTOR_POOL_MAX=10
VECTOR_CONNECTION_TIMEOUT=5000

# 回退配置
VECTOR_FALLBACK_ENABLED=true
VECTOR_FALLBACK_RETRY=3
VECTOR_FALLBACK_DELAY=1000
